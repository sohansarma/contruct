# ---------- App (Vite build-time) ----------
# Unset = DEMO mode (data on device, login code 123456).
# Empty  = LIVE mode, API on the same origin (site served by `npm start`).
# URL    = LIVE mode, API elsewhere — required for the Android/iOS apps:
# VITE_API_URL=https://api.yourdomain.in
VITE_API_URL=
VITE_SUPPORT_PHONE=+919000000000
VITE_SUPPORT_EMAIL=support@example.com

# ---------- Server (npm start) ----------
NODE_ENV=production
PORT=8080
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/buildrun
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Your admin phone numbers (comma-separated, +91…)
ADMIN_PHONES=+919000000000
# Extra web origins allowed to call the API (Capacitor origins are built in)
CORS_ORIGINS=https://yourdomain.in

# OTP SMS: msg91 | twilio | console (console logs codes — dev only)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Order status texts (placed, confirmed, out for delivery, delivered, cancelled, returned):
# a DLT template with the variables ##order## and ##status##
MSG91_ORDER_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=
# Fixed codes for app-store reviewers: +919999999999:123456
TEST_LOGINS=

# Razorpay (UPI, cards, net banking, wallets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Development only: simulate online payments when Razorpay keys are absent
ALLOW_MOCK_PAYMENTS=0
